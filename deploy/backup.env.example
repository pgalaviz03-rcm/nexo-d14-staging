# Valores reales en Secret Manager del ejecutor; ejemplo sin credenciales.
PGHOST=
PGPORT=5432
PGDATABASE=postgres
PGUSER=
PGPASSWORD=
PGSSLMODE=verify-full
PGSSLROOTCERT=/etc/secrets/supabase-ca.crt
NEXO_BACKUP_BUCKET=
NEXO_BACKUP_PREFIX=nexo/production
NEXO_BACKUP_RECIPIENT=age1_REEMPLAZAR_CLAVE_PUBLICA
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_ENDPOINT_URL=
