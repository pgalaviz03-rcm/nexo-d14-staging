# Perfil local: sin credenciales de nube ni APIs.
NEXO_ENV=local
NEXO_LOCAL_WORKSPACE=true
NEXO_OFFLINE=true
NEXO_AI_ENABLED=false
NEXO_RELEASE_APPROVED=false
NEXO_RSS_ALLOWED_HOSTS=
NEXO_STORAGE_MODE=filesystem
# El iniciador resuelve DATABASE_URL, almacenamiento y clave fuera del código.
# No copiar la clave de sesión ni la base privada a un repositorio.

# Programación y bandeja de simulación locales; ningún proveedor se conecta.
# La clave de sesión privada permite recuperar los destinos cifrados locales.

# Optional separate Fernet key for encrypted integration credentials; server only.
# Empty in local mode derives a separate key from the private local session key.
NEXO_INTEGRATIONS_ENCRYPTION_KEY=
