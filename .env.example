# NEXO 0.5. Sin credenciales reales. No compartir .env.
NEXO_ENV=local
DATABASE_URL=sqlite:///./storage/nexo.db
NEXO_STORAGE_MODE=filesystem
NEXO_SECRET_KEY=
NEXO_SESSION_HOURS=1
NEXO_RSS_ALLOWED_HOSTS=
NEXO_AI_ENABLED=false
NEXO_RELEASE_APPROVED=false
# Nube: staging y production requieren proyectos y credenciales DISTINTOS.
# NEXO_ENV=staging
# DATABASE_URL=postgresql+psycopg://nexo_app.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=verify-full&sslrootcert=/etc/secrets/supabase-ca.crt
# Usar pooler SESSION (5432), no transaction pooler en esta entrega.
# NEXO_STORAGE_MODE=database
# NEXO_PUBLIC_ORIGIN=https://HOST_OBSERVADO_EN_RENDER.onrender.com
# NEXO_SUPABASE_URL=https://PROJECT_REF.supabase.co
# NEXO_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REEMPLAZAR_EN_PANEL
# Credencial de migración: solo terminal administrativa, jamás en servicio web.
# NEXO_MIGRATION_DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=verify-full&sslrootcert=RUTA_CA
# Docker local:
NEXO_DB_OWNER_PASSWORD=
NEXO_APP_DB_PASSWORD=
