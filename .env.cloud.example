DATABASE_URL=
# Independent Fernet keys, generated and retained privately before deployment.
NEXO_INTEGRATIONS_ENCRYPTION_KEY=
NEXO_DELIVERY_ENCRYPTION_KEY=
# Preserve the explicitly authorized exact RSS domains from existing service.
NEXO_RSS_ALLOWED_HOSTS=
