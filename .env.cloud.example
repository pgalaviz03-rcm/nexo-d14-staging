# Render staging only. Copy values using provider secret controls, never Git.
NEXO_ENV=staging
NEXO_STORAGE_MODE=database
NEXO_AI_ENABLED=false
NEXO_RELEASE_APPROVED=false
NEXO_PUBLIC_ORIGIN=https://nexo-d14-staging.onrender.com
